{
	"extends": "@c15t/typescript-config/base.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"#c15t/stub": ["./src/runtime/stub.vue.ts"],
			"#c15t/composables": ["./src/runtime/composables/index.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.vue",
		"src/env.d.ts",
		"src/c15t-aliases.d.ts",
		"src/nuxt-imports.d.ts"
	],
	"exclude": ["src/**/*.nuxt.ts", "src/runtime/stub-contract.ts"]
}
